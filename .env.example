# Copiar a .env (git lo ignora) y ajustar. Todas las variables son opcionales:
# sin .env, los valores por defecto son los de la derecha.

# Versión de las imágenes del visor en ghcr.io/pbarbecho/sumo-geo-*:
#   main (última), vX.Y.Z (tag fijado por curso) o sha-xxxxxxx (commit)
#SUMO_GEO_TAG=main

# Rama/tag del fork VaN3TwinGEO que clona la imagen van3twin al construirse
#VAN3TWIN_REF=master

# Mapa que dibuja el visor (el del escenario que corre ns-3):
#   EVA (por defecto): /ns3/ns-3-dev/src/automotive/examples/sumo_files_v2v_map/map.net.xml
#   Cuenca:            /replay/cuenca/cuenca.net.xml  (carpeta results/cuenca)
#SUMO_GEO_NET=/replay/cuenca/cuenca.net.xml
# Polígonos (edificios 3D, zonas verdes, agua, árboles) del mismo escenario:
#SUMO_GEO_POLY=/replay/cuenca/cuenca.poly.xml


# Solo con docker-compose.build.yml (construir el visor localmente):
#SUMO_GEO_REPO=https://github.com/Pbarbecho/SUMO_GEO.git
#SUMO_GEO_REF=main
